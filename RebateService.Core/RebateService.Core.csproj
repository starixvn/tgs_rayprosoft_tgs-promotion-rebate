<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.Services.Rebate</RootNamespace>
    <SqlQueryToolsConnectionString />
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Protos\messages.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.10" />
    <PackageReference Include="Grpc.Tools" Version="2.51.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.4.27">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="System.Interactive.Async" Version="6.0.1" />
    <PackageReference Include="Tgs.MessageQueue" Version="2.1.1" />
    <PackageReference Include="Tgs.Promotion.Client" Version="1.0.36" />
    <PackageReference Include="Tgs.SerialNumberGenerator" Version="0.0.5" />
    <PackageReference Include="TGS.ServiceUtility" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\messages.proto">
      <Access>Public</Access>
      <GrpcServices>None</GrpcServices>
    </Protobuf>
  </ItemGroup>

</Project>
