<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tgs.Services.Rebate</RootNamespace>
    <SqlQueryToolsConnectionString />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.22.3" />
    <PackageReference Include="Grpc.Tools" Version="2.54.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.5.22">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NCrontab.Signed" Version="3.3.2" />
    <PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
    <PackageReference Include="System.Interactive.Async" Version="6.0.1" />
    <PackageReference Include="Tgs.BrandCertificateClient" Version="0.0.25" />
    <PackageReference Include="Tgs.MessageQueue" Version="2.3.0" />
    <PackageReference Include="Tgs.Promotion.Client" Version="1.0.42" />
    <PackageReference Include="Tgs.SerialNumberGenerator" Version="1.0.0" />
    <PackageReference Include="TGS.ServiceUtility" Version="0.2.0" />
  </ItemGroup>

	<ItemGroup>
		<Protobuf Include="Protos\messages.proto">
			<Access>Public</Access>
			<GrpcServices>None</GrpcServices>
		</Protobuf>
	</ItemGroup>

</Project>
